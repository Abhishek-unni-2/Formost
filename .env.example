# ── Database (Neon Postgres) ───────────────────────────────
# Set by the Vercel <-> Neon integration automatically, or paste
# your Neon connection string here for `vercel dev` / local API testing.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Force the frontend to hit /api/* during local `vercel dev` (optional).
# Not needed in production — any non-localhost host uses the API automatically.
VITE_USE_API=1

# ── Meta Lead Ads webhook (optional) ───────────────────────
META_VERIFY_TOKEN=FORMOST_VERIFY_2024
META_PAGE_ACCESS_TOKEN=your-meta-page-access-token
